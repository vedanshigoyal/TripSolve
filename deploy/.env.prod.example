# Copy to the repo root on the server as `.env` (deploy.sh does this and fills the secrets).

# Public hostname. Without a domain, use your Elastic IP with dashes + .sslip.io,
# e.g. Elastic IP 13.233.10.5 -> 13-233-10-5.sslip.io
SITE_HOST=

# Generated by deploy.sh if left empty.
POSTGRES_PASSWORD=
JWT_SECRET=

GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
OSRM_URL=https://router.project-osrm.org
SOLVER_TIME_LIMIT_SECONDS=2
