# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://tripsolve:tripsolve@localhost:5433/tripsolve

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Public demo server for development. Point this at a self-hosted OSRM for production.
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# Groq (OpenAI-compatible). Leave GROQ_API_KEY empty to use the deterministic fallbacks.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

SOLVER_TIME_LIMIT_SECONDS=2
CORS_ORIGINS=http://localhost:3000
